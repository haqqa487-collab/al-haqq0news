{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "al-haqq",
  "account_id": "d7cd7f795dea0bde6ac7dfec2932ecf2",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "al-haqq" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "al-haqq-db",
      "database_id": "cf250094-e542-41cf-90bc-fb4cbf13921f",
      "migrations_dir": "migrations"
    }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    { "pattern": "al-haqq.news/*", "zone_name": "al-haqq.news" },
    { "pattern": "www.al-haqq.news/*", "zone_name": "al-haqq.news" }
  ],
  "vars": { "SITE_URL": "https://al-haqq.news" },
  "observability": { "enabled": true }
}
