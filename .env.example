# Copy to .env.local and change every value.
# Password for the editor's admin area at /admin
ADMIN_PASSWORD=change-me-to-a-long-passphrase
# Random string of 32+ characters used to sign admin sessions
SESSION_SECRET=replace-with-a-long-random-string
# Public URL of the site (used for share links, sitemap, SEO)
SITE_URL=http://localhost:3000
